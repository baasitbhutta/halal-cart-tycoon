{
  "name": "halal-cart-tycoon",
  "version": "0.1.0",
  "description": "M1: playable web app (2002-homage UI) + M0 sim core and tuning harness",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "play": "npm run build --silent && node dist/src/harness/play.js",
    "sweep": "npm run build --silent && node dist/src/harness/sweep.js",
    "montecarlo": "npm run build --silent && node dist/src/harness/montecarlo.js",
    "benchmark:turnips": "npm run build --silent && node dist/src/harness/benchmarks/turnips.js",
    "benchmark:lemonade1973": "npm run build --silent && node dist/src/harness/benchmarks/lemonade1973.js",
    "dev": "vite",
    "build:web": "vite build",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}